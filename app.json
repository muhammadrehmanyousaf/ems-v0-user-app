{
  "expo": {
    "name": "Wedding Wala",
    "slug": "wedding-wala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weddingwala",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDF8F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.weddingwala.app"
    },
    "android": {
      "package": "pk.weddingwala.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF8F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d48f0cbf-9da0-4a1a-92ea-30a8d9b0f786"
      }
    },
    "owner": "wedding4455s-team"
  }
}
